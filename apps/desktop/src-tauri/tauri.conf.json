{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Downloader Pro",
  "version": "0.1.0",
  "identifier": "com.eliabe.downloaderpro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Downloader Pro",
        "width": 980,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; connect-src ipc: http://ipc.localhost https://ipc.localhost; media-src 'self' https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
